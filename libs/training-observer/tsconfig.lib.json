{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../dist/out-tsc/training-observer",
        "declaration": true,
        "declarationMap": true,
        "inlineSources": true,
        "types": []
    },
    "include": ["src/**/*.ts", "adapters/src/**/*.ts", "models/src/**/*.ts"],
    "exclude": ["**/*.spec.ts", "**/*.test.ts", "jest.config.ts"],
    "angularCompilerOptions": {
        "compilationMode": "partial"
    }
}
