{
    "name": "training-runtime",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/training-runtime/src",
    "prefix": "observer",
    "tags": ["type:library", "layer:runtime"],
    "targets": {
        "build": {
            "executor": "@nx/angular:package",
            "outputs": ["{workspaceRoot}/dist/training-runtime"],
            "options": {
                "project": "libs/training-runtime/ng-package.json"
            },
            "configurations": {
                "production": {
                    "tsConfig": "libs/training-runtime/tsconfig.lib.prod.json"
                },
                "development": {
                    "tsConfig": "libs/training-runtime/tsconfig.lib.json"
                }
            },
            "defaultConfiguration": "production"
        },
        "lint": {
            "executor": "@nx/eslint:lint",
            "options": {
                "quiet": true,
                "eslintConfig": "libs/training-runtime/eslint.config.mjs",
                "lintFilePatterns": ["libs/training-runtime/**/*.ts", "libs/training-runtime/**/*.html"]
            },
            "configurations": {
                "fix": {
                    "fix": true
                }
            }
        }
    }
}
