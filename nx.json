{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "defaultBase": "main",
    "workspaceLayout": {
        "appsDir": "projects",
        "libsDir": "libs"
    },
    "namedInputs": {
        "default": ["{projectRoot}/**/*", "sharedGlobals"],
        "sharedGlobals": [
            "{workspaceRoot}/tsconfig.base.json",
            "{workspaceRoot}/package.json",
            "{workspaceRoot}/package-lock.json",
            "{workspaceRoot}/nx.json"
        ],
        "production": ["default", "!{projectRoot}/**/*.spec.ts"]
    },
    "targetDefaults": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["production", "^production"],
            "cache": true
        }
    },
    "generators": {
        "@nx/angular:application": {
            "style": "less",
            "standalone": true,
            "strict": true,
            "linter": "none",
            "unitTestRunner": "none",
            "e2eTestRunner": "none"
        },
        "@nx/angular:library": {
            "style": "less",
            "standalone": true,
            "strict": true,
            "linter": "none",
            "unitTestRunner": "none"
        }
    }
}
