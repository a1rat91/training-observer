{
    "name": "training-observer",
    "version": "0.0.0",
    "description": "POC для отслеживаний событий в тренажере",
    "homepage": "https://github.com/a1rat91/training-observer",
    "bugs": "https://github.com/a1rat91/training-observer/issues",
    "repository": {
        "type": "git",
        "url": "https://github.com/a1rat91/training-observer"
    },
    "license": "Apache-2.0",
    "author": {
        "name": "Airat Khairullin",
        "email": "a1rat91@yandex.ru",
        "url": "https://t.me/a1rat91"
    },
    "scripts": {
        "build": "npx nx run-many --target=build --all --configuration=production",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "prepare": "husky",
        "prettier": "prettier --write !package-lock.json . --ignore-path .gitignore",
        "release": "npx syncer && npx nx run-many -t publish",
        "start": "nx serve demo",
        "stylelint": "stylelint '**/*.{less,css}' --config package.json",
        "stylelint:fix": "stylelint '**/*.{less,css}' --config package.json --fix",
        "test": "nx run-many --target=test --projects=training-observer"
    },
    "commitlint": {
        "extends": [
            "@taiga-ui/commitlint-config"
        ]
    },
    "lint-staged": {
        "*.less": [
            "stylelint --fix"
        ],
        "*.{svg,yml,md,less,json}": [
            "prettier --write"
        ],
        "*.{ts,html}": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "browserslist": [
        "extends @taiga-ui/browserslist-config",
        "Chrome >= 73"
    ],
    "prettier": "@taiga-ui/prettier-config",
    "stylelint": {
        "extends": [
            "@taiga-ui/stylelint-config"
        ]
    },
    "devDependencies": {
        "@angular-builders/custom-webpack": "19.0.1",
        "@angular-devkit/build-angular": "19.2.27",
        "@angular-devkit/core": "19.2.27",
        "@angular-devkit/schematics": "19.2.27",
        "@angular/animations": "19.2.25",
        "@angular/cdk": "19.2.19",
        "@angular/cli": "19.2.27",
        "@angular/common": "19.2.25",
        "@angular/compiler": "19.2.25",
        "@angular/compiler-cli": "19.2.25",
        "@angular/core": "19.2.25",
        "@angular/forms": "19.2.25",
        "@angular/platform-browser": "19.2.25",
        "@angular/platform-browser-dynamic": "19.2.25",
        "@angular/platform-server": "19.2.25",
        "@angular/router": "19.2.25",
        "@angular/ssr": "19.2.27",
        "@ng-web-apis/common": "4.14.1",
        "@ng-web-apis/intersection-observer": "4.14.1",
        "@ng-web-apis/mutation-observer": "4.14.1",
        "@ng-web-apis/platform": "4.14.1",
        "@ng-web-apis/resize-observer": "4.14.1",
        "@ng-web-apis/screen-orientation": "4.14.1",
        "@ng-web-apis/universal": "^4.14.1",
        "@nx/angular": "20.8.4",
        "@nx/jest": "20.8.4",
        "@nx/js": "20.8.4",
        "@nx/node": "20.8.4",
        "@nx/workspace": "20.8.4",
        "@schematics/angular": "19.2.27",
        "@taiga-ui/addon-charts": "^4.98.0",
        "@taiga-ui/addon-commerce": "^4.98.0",
        "@taiga-ui/addon-doc": "^4.98.0",
        "@taiga-ui/addon-mobile": "^4.98.0",
        "@taiga-ui/addon-table": "^4.98.0",
        "@taiga-ui/auto-changelog-config": "0.332.0",
        "@taiga-ui/browserslist-config": "^0.560.0",
        "@taiga-ui/cdk": "^4.98.0",
        "@taiga-ui/commitlint-config": "0.332.0",
        "@taiga-ui/core": "^4.98.0",
        "@taiga-ui/eslint-plugin-experience-next": "^0.560.0",
        "@taiga-ui/event-plugins": "^4.0.2",
        "@taiga-ui/icons": "^4.98.0",
        "@taiga-ui/kit": "^4.98.0",
        "@taiga-ui/layout": "^4.98.0",
        "@taiga-ui/prettier-config": "0.332.0",
        "@taiga-ui/release-it-config": "0.332.0",
        "@taiga-ui/stylelint-config": "0.332.0",
        "@taiga-ui/tsconfig": "^0.560.0",
        "@types/d3-hierarchy": "3.1.7",
        "@types/express": "4.17.25",
        "@types/jest": "29.5.14",
        "@types/markdown-it": "14.1.2",
        "@types/node": "25.9.4",
        "browser-sync": "3.0.4",
        "core-js": "3.49.0",
        "d3-hierarchy": "3.1.2",
        "express": "4.22.2",
        "http-server": "14.1.1",
        "husky": "9.1.7",
        "jest": "29.7.0",
        "jest-environment-jsdom": "29.7.0",
        "jest-preset-angular": "14.6.2",
        "lint-staged": "15.5.2",
        "marked": "15.0.12",
        "ng-mocks": "14.15.3",
        "ng-packagr": "19.2.2",
        "ngx-markdown": "19.1.1",
        "nx": "20.8.4",
        "rxjs": "7.8.2",
        "ts-jest": "29.4.11",
        "ts-node": "10.9.2",
        "tslib": "2.8.1",
        "tsutils": "3.21.0",
        "typescript": "5.8.3",
        "webpack": "5.108.4",
        "webpack-merge": "6.0.1",
        "zone.js": "0.15.1"
    },
    "syncer": {
        "includePaths": [
            "./projects",
            "./package-lock.json"
        ],
        "matchPackageNames": [
            "@training-observer/*",
            "training-observer"
        ],
        "ignorePackageNames": [
            "@training-observer/ignored"
        ]
    }
}
